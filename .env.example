# Bundled database. Letters and digits only: openssl rand -hex 24
POSTGRES_PASSWORD=

# Your own database instead (docker-compose.external-db.yml). Use sslmode=verify-full or require.
TUCK_DATABASE_URL=

# ssh, files or both
TUCK_FEATURES=both

# Your HTTPS proxy's address or range, e.g. 172.16.0.0/12. Required behind a proxy.
TUCK_TRUSTED_PROXIES=

# Optional. Long and random: anyone can guess at it.
TUCK_GATE_PASSWORD=
TUCK_GATE_WORD=

TUCK_FREEZE_AFTER=6
TUCK_MAX_ITEMS=5000
TUCK_MAX_STORAGE_MB=1024

# false only for local testing over plain HTTP
TUCK_SECURE_COOKIES=true

TUCK_BIND=127.0.0.1
TUCK_PORT=8080
